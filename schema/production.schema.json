{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyforge.motionssalt.com/schema/production.schema.json",
  "title": "StoryForge Production JSON",
  "description": "Production script, narration emotion tags, and Reddit card timeline for a single or two-part StoryForge vertical video.",
  "type": "object",
  "required": ["series_title", "format", "parts"],
  "additionalProperties": false,
  "properties": {
    "series_title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 140
    },
    "format": {
      "type": "string",
      "enum": ["single", "two_part"]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "emotion": {
      "type": "string",
      "enum": ["calm", "tense", "angry", "shocked", "sad", "sarcastic", "whisper", "excited"]
    },
    "marker": {
      "type": "string",
      "enum": ["pause", "sigh", "laugh"]
    },
    "line": {
      "type": "object",
      "required": ["id", "text", "emotion"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L[0-9]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        }
      }
    },
    "award": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["gold", "helpful", "heart"]
        },
        "count": {
          "type": ["integer", "string"]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "body_content": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["bullets"],
                "additionalProperties": false,
                "properties": {
                  "bullets": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "reply_object": {
      "type": "object",
      "required": ["username", "body"],
      "additionalProperties": false,
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "age": { "type": "string" },
        "awards": {
          "type": "array",
          "items": { "$ref": "#/$defs/award" }
        },
        "body": { "$ref": "#/$defs/body_content" }
      }
    },
    "card_data": {
      "type": "object",
      "required": ["type", "theme"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["post", "comment", "reply", "branded"]
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "subreddit": { "type": "string" },
        "subreddit_icon_url": { "type": "string" },
        "username": { "type": "string" },
        "age": { "type": "string" },
        "awards": {
          "type": "array",
          "items": { "$ref": "#/$defs/award" }
        },
        "nsfw": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "title": { "type": "string" },
        "body": { "$ref": "#/$defs/body_content" },
        "handle": { "type": "string" },
        "emoji_row": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "likes": { "type": "string" },
        "shares": { "type": "string" },
        "upvotes": { "type": "string" },
        "comments_count": { "type": "string" },
        "show_footer": { "type": "boolean" },
        "reply": { "$ref": "#/$defs/reply_object" }
      }
    },
    "card_timeline_item": {
      "type": "object",
      "required": ["from_line", "to_line", "card"],
      "additionalProperties": false,
      "properties": {
        "from_line": {
          "type": "string",
          "pattern": "^L[0-9]+$"
        },
        "to_line": {
          "type": "string",
          "pattern": "^L[0-9]+$"
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60
        },
        "card": { "$ref": "#/$defs/card_data" }
      }
    },
    "part": {
      "type": "object",
      "required": ["part_number", "title", "hashtags", "story_so_far", "lines", "cards"],
      "additionalProperties": false,
      "properties": {
        "part_number": {
          "type": "integer",
          "enum": [1, 2]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "hashtags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^#[A-Za-z0-9_]+$"
          }
        },
        "story_so_far": {
          "type": "string",
          "maxLength": 500
        },
        "lines": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/line" }
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card_timeline_item" }
        }
      }
    }
  }
}
