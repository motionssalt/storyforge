{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyforge.motionssalt.com/schema/production.schema.json",
  "title": "StoryForge Production JSON v3",
  "description": "Production script, narration emotion tags, and persistent Reddit post metadata for a single or two-part StoryForge vertical video.",
  "type": "object",
  "required": [
    "schema_version",
    "series_title",
    "format",
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "series_title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 140
    },
    "format": {
      "type": "string",
      "enum": [
        "single",
        "two_part"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "emotion": {
      "type": "string",
      "enum": [
        "calm",
        "tense",
        "angry",
        "shocked",
        "sad",
        "sarcastic",
        "whisper",
        "excited"
      ]
    },
    "marker": {
      "type": "string",
      "enum": [
        "pause",
        "sigh",
        "laugh"
      ]
    },
    "line": {
      "type": "object",
      "required": [
        "id",
        "text",
        "emotion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L[0-9]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        }
      }
    },
    "award": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "gold",
            "helpful",
            "heart"
          ]
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "post": {
      "type": "object",
      "required": [
        "subreddit",
        "username",
        "title",
        "theme",
        "age",
        "upvotes",
        "comments",
        "shares",
        "awards",
        "nsfw",
        "verified",
        "avatar"
      ],
      "additionalProperties": false,
      "properties": {
        "subreddit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "age": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "awards": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/award"
              }
            },
            {
              "$ref": "#/$defs/count"
            }
          ]
        },
        "nsfw": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "theme": {
          "type": "string",
          "enum": [
            "dark",
            "light"
          ]
        },
        "upvotes": {
          "$ref": "#/$defs/count"
        },
        "show_footer": {
          "type": "boolean"
        },
        "comments": {
          "$ref": "#/$defs/count"
        },
        "shares": {
          "$ref": "#/$defs/count"
        },
        "karma": {
          "$ref": "#/$defs/count"
        },
        "follower_count": {
          "$ref": "#/$defs/count"
        },
        "flair": {
          "type": "string",
          "maxLength": 32
        },
        "avatar": {
          "type": "object",
          "required": [
            "style"
          ],
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "photo_person",
                "photo_object",
                "photo_animal",
                "photo_scenery",
                "cartoon"
              ]
            },
            "gender": {
              "enum": [
                "male",
                "female",
                "any"
              ]
            },
            "keyword": {
              "type": "string",
              "maxLength": 32
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "karma"
          ]
        },
        {
          "required": [
            "follower_count"
          ]
        }
      ]
    },
    "part": {
      "type": "object",
      "required": [
        "part_number",
        "title",
        "description",
        "hashtags",
        "story_so_far",
        "post",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "part_number": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "hashtags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^#[A-Za-z0-9_]+$"
          }
        },
        "story_so_far": {
          "type": "string",
          "maxLength": 500
        },
        "post": {
          "$ref": "#/$defs/post"
        },
        "lines": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/line"
          },
          "maxItems": 200
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        }
      }
    },
    "count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999999
        },
        {
          "type": "string",
          "pattern": "^\\d{1,12}(?:\\.\\d{1,2})?[kKmMbB]?$"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "single"
          }
        }
      },
      "then": {
        "properties": {
          "parts": {
            "maxItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "parts": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
